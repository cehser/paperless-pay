# ==========================================================================
# .env – cookie-passthrough-check PoC
# ==========================================================================
# Kopiere diese Datei nach pay-poc/.env und passe sie ggf. an.
# Defaults passen für den Standard-Paperless-Stack (Service "paperless",
# Port 8000).
# ==========================================================================

# --- Upstream Paperless -----------------------------------------------------
# Service-Name + Port von Paperless im Docker-Netz.
# Nur ändern, falls dein Service anders heißt.
PAPERLESS_BASE_URL=http://paperless:8000

# --- PoC-Einstellungen ------------------------------------------------------
# Host-Port des PoC (intern immer 8080)
COOKIE_POC_PORT=8081
# Basis-Pfad für alle PoC-Routes (muss zum nginx-location-Block passen)
APP_BASE_PATH=/qr-poc
# Auf true/1 setzen für erweiterte Header-Logs im PoC
DEBUG_UPSTREAM=false
