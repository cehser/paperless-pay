# ==========================================================================
# .env – paperless-pay (Web App)
# ==========================================================================
# Copy this file to .env and adjust the values.
# Custom field IDs can be found in Paperless under: Admin → Custom Fields
#
# NOTE: Worker settings are in a separate file (.env.worker).
#       This prevents the API token from being exposed to the web app.
# ==========================================================================

# --- Upstream Paperless -----------------------------------------------------
PAPERLESS_BASE_URL=http://webserver:8000
# Public URL for the PDF iframe (if different from internal URL, e.g. behind reverse proxy)
# If empty, PAPERLESS_BASE_URL is used.
PAPERLESS_PUBLIC_URL=

# --- App --------------------------------------------------------------------
APP_BASE_PATH=/pay
DEBUG_UPSTREAM=false

# --- Locale -----------------------------------------------------------------
# Supported: en, de
LANGUAGE=en

# --- Feature Switches -------------------------------------------------------
# Experimental: make fields editable directly in paperless-pay
ENABLE_EDIT=false

# --- Custom Field IDs (required, except BIC) --------------------------------
# Look up the IDs in Paperless Admin → Custom Fields.
CF_IBAN=
CF_BIC=
# CF_BIC is optional – leave empty or omit if not available.
CF_AMOUNT=
CF_REMITTANCE=
CF_PAID=

# --- Remittance Info Template (optional) ------------------------------------
# Available variables: {remittance}, {title}, {correspondent}, {doc_id}
# Example: INV {remittance} / {correspondent}
REMITTANCE_TEMPLATE={remittance}
