# ==========================================================================
# .env – paperless-pay
# ==========================================================================
# Kopiere diese Datei nach pay-poc/.env und passe die Custom Field IDs an.
# IDs findest du in Paperless unter: Admin → Custom Fields
# ==========================================================================

# --- Upstream Paperless -----------------------------------------------------
PAPERLESS_BASE_URL=http://webserver:8000
# Öffentliche URL für PDF-iframe (falls anders als interne URL, z.B. hinter Reverse Proxy)
# Wenn leer, wird PAPERLESS_BASE_URL verwendet.
PAPERLESS_PUBLIC_URL=

# --- App --------------------------------------------------------------------
APP_BASE_PATH=/pay
COOKIE_POC_PORT=8081
DEBUG_UPSTREAM=false

# --- Custom Field IDs (PFLICHT) ---------------------------------------------
# Aus Paperless Admin → Custom Fields die IDs ablesen.
CF_IBAN=
CF_BIC=
CF_BETRAG=
CF_VERWENDUNGSZWECK=
CF_BEZAHLT=

# --- Verwendungszweck-Template (optional) -----------------------------------
# Verfügbare Variablen: {verwendungszweck}, {title}, {correspondent}, {doc_id}
# Beispiel: RE {verwendungszweck} / {correspondent}
VERWENDUNGSZWECK_TEMPLATE={verwendungszweck}
