# ==========================================================================
# .env – paperless-pay
# ==========================================================================
# Kopiere diese Datei nach .env und passe die Werte an.
# Custom Field IDs findest du in Paperless unter: Admin → Custom Fields
# ==========================================================================

# --- Upstream Paperless -----------------------------------------------------
PAPERLESS_BASE_URL=http://webserver:8000
# Öffentliche URL für PDF-iframe (falls anders als interne URL, z.B. hinter Reverse Proxy)
# Wenn leer, wird PAPERLESS_BASE_URL verwendet.
PAPERLESS_PUBLIC_URL=

# --- App --------------------------------------------------------------------
APP_BASE_PATH=/pay
COOKIE_POC_PORT=8081
DEBUG_UPSTREAM=false

# --- Feature Switches -------------------------------------------------------
# Experimentell: Felder direkt in paperless-pay editierbar machen
ENABLE_EDIT=false

# --- Custom Field IDs (PFLICHT, außer BIC) ----------------------------------
# Aus Paperless Admin → Custom Fields die IDs ablesen.
CF_IBAN=
CF_BIC=
# CF_BIC ist optional – leer lassen oder weglassen wenn nicht vorhanden.
CF_BETRAG=
CF_VERWENDUNGSZWECK=
CF_BEZAHLT=

# --- Verwendungszweck-Template (optional) -----------------------------------
# Verfügbare Variablen: {verwendungszweck}, {title}, {correspondent}, {doc_id}
# Beispiel: RE {verwendungszweck} / {correspondent}
VERWENDUNGSZWECK_TEMPLATE={verwendungszweck}

# ==========================================================================
# Link-Worker – setzt Pay-Links automatisch in ein URL-Custom-Field
# ==========================================================================

# API-Token für den Worker (Paperless Admin → Tokens)
PAPERLESS_TOKEN=

# Custom-Field-ID für den Pay-Link (Typ: URL)
CF_LINK=

# Öffentliche Basis-URL von paperless-pay (ohne trailing slash)
PAY_PUBLIC_URL=https://docs.example.com/pay

# Filter für Dokumente (Paperless API query params)
# Beispiele:
#   document_type__id=3              → nur DocType "Rechnung"
#   tags__id__all=5                  → nur Dokumente mit Tag-ID 5
#   correspondent__id=2              → nur bestimmter Korrespondent
#   document_type__id=3&tags__id__all=5  → Kombination
#   (leer = ALLE Dokumente – Vorsicht!)
WORKER_FILTER=

# Polling-Intervall in Sekunden
WORKER_INTERVAL=60
