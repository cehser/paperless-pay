# ==========================================================================
# .env.worker – paperless-pay (Link Worker)
# ==========================================================================
# Copy this file to .env.worker and adjust the values.
#
# The worker uses an API token for authentication (headless, no cookies).
# Keeping this separate from the web app's .env ensures the token is
# never exposed to the cookie-based web frontend.
# ==========================================================================

# --- Upstream Paperless -----------------------------------------------------
PAPERLESS_BASE_URL=http://webserver:8000

# --- API Token (required) --------------------------------------------------
# Create in Paperless Admin → Tokens (or /admin/authtoken/tokenproxy/).
# Must be a user with write permissions on custom fields.
PAPERLESS_TOKEN=

# --- Custom field ID for the pay-link (type: URL) --------------------------
CF_LINK=

# --- Public base URL of paperless-pay (without trailing slash) --------------
PAY_PUBLIC_URL=https://docs.example.com/pay

# --- Filter for documents (Paperless API query params) ----------------------
# Examples:
#   document_type__id=3              → only doc type "Invoice"
#   tags__id__all=5                  → only documents with tag ID 5
#   correspondent__id=2              → only a specific correspondent
#   document_type__id=3&tags__id__all=5  → combination
#   (empty = ALL documents – use with caution!)
WORKER_FILTER=

# --- Polling interval in seconds --------------------------------------------
WORKER_INTERVAL=60
